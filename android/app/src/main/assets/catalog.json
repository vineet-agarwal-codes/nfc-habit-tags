{
  "appGroups": [
    {
      "id": "social",
      "title": "Social media",
      "androidPackages": [
        "com.instagram.android",
        "com.facebook.katana",
        "com.twitter.android",
        "com.snapchat.android",
        "in.mohalla.sharechat",
        "com.reddit.frontpage"
      ]
    },
    {
      "id": "video",
      "title": "Video and streaming",
      "androidPackages": [
        "com.google.android.youtube",
        "com.netflix.mediaclient",
        "in.startv.hotstar",
        "com.amazon.avod.thirdpartyclient"
      ]
    },
    {
      "id": "messaging",
      "title": "Messaging",
      "androidPackages": [
        "com.whatsapp",
        "org.telegram.messenger"
      ]
    },
    {
      "id": "games",
      "title": "Games",
      "androidPackages": []
    }
  ],
  "recipes": [
    {
      "id": "desk-deep-work",
      "schemaVersion": 3,
      "version": 3,
      "title": "Desk: Deep Work",
      "description": "Tap when you sit down to work. Social media and video apps are blocked and notifications go quiet until the timer ends. Tapping again won't stop it; End early in the app will.",
      "placementHint": "Stick it on your desk where your phone rests, or under the desk edge.",
      "mode": "toggle",
      "params": [
        {
          "key": "autoOffMinutes",
          "type": "duration",
          "label": "Turn off automatically after",
          "default": 90,
          "min": 15,
          "max": 480
        }
      ],
      "autoOffMinutes": "{{autoOffMinutes}}",
      "rules": [
        {
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        }
      ],
      "space": {
        "name": "Desk",
        "colour": "tomato"
      },
      "place": "desk",
      "tagCanEnd": false
    },
    {
      "id": "bed-sleep",
      "schemaVersion": 3,
      "version": 4,
      "title": "Bed: Sleep Mode",
      "description": "Tap at bedtime to block distracting apps and silence notifications. Sleep mode ends at your wake-up time, or later if you went to bed late, and starts your morning routine.",
      "placementHint": "Stick it on your bedside table where your phone stays overnight.",
      "mode": "toggle",
      "params": [
        {
          "key": "usualBedtime",
          "type": "time",
          "label": "Usual bedtime",
          "default": 1380,
          "min": 0,
          "max": 1439
        },
        {
          "key": "wakeAt",
          "type": "time",
          "label": "Wake up at",
          "default": 300,
          "min": 0,
          "max": 1439,
          "renamedFrom": "sleepEnd"
        },
        {
          "key": "latestWake",
          "type": "time",
          "label": "Latest wake-up",
          "default": 480,
          "min": 0,
          "max": 1439
        }
      ],
      "rules": [
        {
          "when": {
            "time": "{{usualBedtime-180}}-{{wakeAt}}"
          },
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video",
                "games"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        },
        {
          "actions": [
            {
              "type": "log",
              "label": "Bed tap outside night hours"
            }
          ]
        }
      ],
      "endActions": [
        {
          "type": "checklist",
          "title": "Good morning",
          "items": [
            "Drink a glass of water",
            "Make the bed",
            "Put on workout clothes"
          ]
        }
      ],
      "space": {
        "name": "Bed",
        "colour": "deep_blue"
      },
      "place": "bed",
      "tagCanEnd": false,
      "endPolicy": {
        "type": "wake",
        "wakeAt": "{{wakeAt}}",
        "usual": "{{usualBedtime}}",
        "latest": "{{latestWake}}"
      }
    },
    {
      "id": "gym-bag",
      "schemaVersion": 1,
      "version": 2,
      "title": "Gym Bag: Workout",
      "description": "Tap when you pick up your gym bag. Starts a one hour workout timer and logs the workout.",
      "placementHint": "Stick it inside your gym bag or on its strap.",
      "mode": "oneShot",
      "rules": [
        {
          "actions": [
            {
              "type": "timer",
              "minutes": 60
            },
            {
              "type": "log",
              "label": "Workout"
            },
            {
              "type": "checklist",
              "title": "Before you go",
              "items": [
                "Water bottle",
                "Headphones",
                "Towel"
              ]
            }
          ]
        }
      ],
      "space": {
        "name": "Gym bag",
        "colour": "green"
      },
      "place": "workout"
    },
    {
      "id": "front-door",
      "schemaVersion": 1,
      "version": 2,
      "title": "Front Door: Leaving Home",
      "description": "Tap on your way out for a quick checklist so you never forget the essentials.",
      "placementHint": "Stick it next to the door handle or on the key bowl.",
      "mode": "oneShot",
      "rules": [
        {
          "actions": [
            {
              "type": "checklist",
              "title": "Leaving home",
              "items": [
                "Keys",
                "Wallet",
                "Phone charger",
                "Lights off"
              ]
            }
          ]
        }
      ],
      "space": {
        "name": "Front door"
      },
      "place": "leaving"
    }
  ]
}
