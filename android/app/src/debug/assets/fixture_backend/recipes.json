[
  {
    "id": "desk-deep-work",
    "doc": {
      "id": "desk-deep-work",
      "schemaVersion": 3,
      "version": 2,
      "title": "Desk: Deep Work",
      "description": "Tap when you sit down to work. Social media and video apps are blocked and notifications go quiet until the timer ends. Tapping again won't stop it; End early in the app will.",
      "placementHint": "Stick it on your desk where your phone rests, or under the desk edge.",
      "mode": "toggle",
      "params": [
        {
          "key": "autoOffMinutes",
          "type": "duration",
          "label": "Turn off automatically after",
          "default": 90,
          "min": 15,
          "max": 480
        }
      ],
      "autoOffMinutes": "{{autoOffMinutes}}",
      "rules": [
        {
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        }
      ],
      "space": {
        "name": "Desk",
        "colour": "tomato"
      },
      "place": "desk",
      "tagCanEnd": false
    },
    "published_at": "2026-11-01T00:00:00+00:00",
    "sort_hint": 0
  },
  {
    "id": "bed-sleep",
    "doc": {
      "id": "bed-sleep",
      "schemaVersion": 3,
      "version": 3,
      "title": "Bed: Sleep Mode",
      "description": "Tap at bedtime to block distracting apps and silence notifications. Sleep mode ends at your wake-up time, or later if you went to bed late, and starts your morning routine.",
      "placementHint": "Stick it on your bedside table where your phone stays overnight.",
      "mode": "toggle",
      "params": [
        {
          "key": "usualBedtime",
          "type": "time",
          "label": "Usual bedtime",
          "default": 1380,
          "min": 0,
          "max": 1439
        },
        {
          "key": "wakeAt",
          "type": "time",
          "label": "Wake up at",
          "default": 300,
          "min": 0,
          "max": 1439,
          "renamedFrom": "sleepEnd"
        },
        {
          "key": "latestWake",
          "type": "time",
          "label": "Latest wake-up",
          "default": 480,
          "min": 0,
          "max": 1439
        },
        {
          "key": "napMinutes",
          "type": "duration",
          "label": "Nap length",
          "default": 60,
          "min": 15,
          "max": 240
        }
      ],
      "rules": [
        {
          "when": {
            "time": "{{usualBedtime-180}}-{{wakeAt}}"
          },
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video",
                "games"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        },
        {
          "actions": [
            {
              "type": "log",
              "label": "Bed tap outside night hours"
            }
          ]
        }
      ],
      "endActions": [
        {
          "type": "checklist",
          "title": "Good morning",
          "items": [
            "Drink a glass of water",
            "Make the bed",
            "Put on workout clothes"
          ]
        }
      ],
      "space": {
        "name": "Bed",
        "colour": "deep_blue"
      },
      "place": "bed",
      "tagCanEnd": false,
      "endPolicy": {
        "type": "wake",
        "wakeAt": "{{wakeAt}}",
        "usual": "{{usualBedtime}}",
        "latest": "{{latestWake}}",
        "nap": "{{napMinutes}}"
      }
    },
    "published_at": "2026-11-01T00:00:00+00:00",
    "sort_hint": 10
  },
