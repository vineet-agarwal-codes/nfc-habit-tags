  {
    "id": "desk-deep-work",
    "doc": {
      "id": "desk-deep-work",
      "schemaVersion": 1,
      "version": 1,
      "title": "Desk: Deep Work",
      "description": "Tap when you sit down to work. Social media and video apps are blocked and notifications go quiet until you tap again or the timer ends.",
      "placementHint": "Stick it on your desk where your phone rests, or under the desk edge.",
      "mode": "toggle",
      "params": [
        {
          "key": "autoOffMinutes",
          "type": "duration",
          "label": "Turn off automatically after",
          "default": 90,
          "min": 15,
          "max": 480
        },
        {
          "key": "strictMinutes",
          "type": "duration",
          "label": "Can't turn off with the tag for",
          "default": 0,
          "min": 0,
          "max": 240
        }
      ],
      "autoOffMinutes": "{{autoOffMinutes}}",
      "strictMinutes": "{{strictMinutes}}",
      "rules": [
        {
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        }
      ],
      "space": {
        "name": "Desk",
        "colour": "tomato"
      },
      "place": "desk"
    },
    "published_at": "2026-11-01T00:00:00+00:00",
    "sort_hint": 0
  },
  {
    "id": "bed-sleep",
    "doc": {
      "id": "bed-sleep",
      "schemaVersion": 2,
      "version": 2,
      "title": "Bed: Sleep Mode",
      "description": "Tap at night to block distracting apps and silence notifications. Tap again in the morning to end sleep mode and start your morning routine.",
      "placementHint": "Stick it on your bedside table where your phone stays overnight.",
      "mode": "toggle",
      "params": [
        {
          "key": "autoOffMinutes",
          "type": "duration",
          "label": "Wake up mode starts after",
          "default": 480,
          "min": 240,
          "max": 720
        },
        {
          "key": "sleepStart",
          "type": "time",
          "label": "Sleep mode can start from",
          "default": 1260,
          "min": 0,
          "max": 1439
        },
        {
          "key": "sleepEnd",
          "type": "time",
          "label": "until",
          "default": 300,
          "min": 0,
          "max": 1439
        },
        {
          "key": "strictMinutes",
          "type": "duration",
          "label": "Can't turn off with the tag for",
          "default": 0,
          "min": 0,
          "max": 480
        }
      ],
      "autoOffMinutes": "{{autoOffMinutes}}",
      "strictMinutes": "{{strictMinutes}}",
      "rules": [
        {
          "when": {
            "time": "{{sleepStart}}-{{sleepEnd}}"
          },
          "actions": [
            {
              "type": "blockGroups",
              "groups": [
                "social",
                "video",
                "games"
              ]
            },
            {
              "type": "dnd"
            }
          ]
        },
        {
          "actions": [
            {
              "type": "log",
              "label": "Bed tap outside night hours"
            }
          ]
        }
      ],
      "endActions": [
        {
          "type": "checklist",
          "title": "Good morning",
          "items": [
            "Drink a glass of water",
            "Make the bed",
            "Put on workout clothes"
          ]
        }
      ],
      "space": {
        "name": "Bed",
        "colour": "deep_blue"
      },
      "place": "bed"
    },
    "published_at": "2026-11-01T00:00:00+00:00",
    "sort_hint": 10
  },
