# Unverified until the App Store Connect secrets exist; see ios/README.md.
default_platform(:ios)

platform :ios do
  lane :beta do
    key_path = File.expand_path("asc_key.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )
    increment_build_number(build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"), xcodeproj: "HabitTags.xcodeproj")
    build_app(
      project: "HabitTags.xcodeproj",
      scheme: "HabitTags",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')} -allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_path} -authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
